# Shift Handover Briefing - Environment Configuration
# AMD Developer Hackathon - Intelligent Industry Track

# Server settings
PORT=8000
HOST=0.0.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_BYTES=10485760

# Database
DATABASE_PATH=./data/shift_handover.db

# AMD Cloud / ROCm Model Serving Endpoint
# Point to your AMD Developer Cloud vLLM / TGI endpoint or ROCm container
AMD_ENDPOINT_URL=
AMD_API_KEY=
AMD_MODEL_ID=meta-llama/Llama-3.1-70B-Instruct

# Audio transcription adapter settings
# Options: "mock_whisper", "openai_compatible", "local_whisper"
TRANSCRIPTION_ADAPTER=mock_whisper
TRANSCRIPTION_ENDPOINT_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL_ID=whisper-1
